# ─────────────────────────────────────────────────────────────
# Hasanat App — Environment Variables
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────────────

# Auth — auth.hasanat.dev handles authentication
# No secrets needed for shared cookie auth (Cloudflare-hosted apps)
# For OAuth (externally-hosted apps), you'll get these after approval:
# HASANAT_CLIENT_ID=
# HASANAT_CLIENT_SECRET=

# Site
PUBLIC_SITE_URL=http://localhost:4321
PUBLIC_APP_NAME="My Hasanat App"

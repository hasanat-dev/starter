---
import Layout from "@/layouts/Layout.astro";
import { useTranslations, getTranslatedPath } from "@/i18n/utils";
import { getSignInUrl } from "@/lib/auth";

const t = useTranslations("ar");
const user = Astro.locals.user;
---

<Layout>
  <!-- Navbar -->
  <nav class="border-b border-slate-100 bg-white/80 backdrop-blur-sm sticky top-0 z-50">
    <div class="max-w-5xl mx-auto px-4 h-14 flex items-center justify-between">
      <a href="/ar/" class="text-lg font-bold text-hasanat">{t("site.name")}</a>
      <div class="flex items-center gap-4">
        <a href={getTranslatedPath("/", "en")} class="text-sm text-slate-500 hover:text-slate-700">EN</a>
        {user ? (
          <span class="text-sm text-slate-600">{user.name}</span>
        ) : (
          <a href={getSignInUrl(Astro.url.href)} class="btn-primary text-sm !px-4 !py-2">{t("nav.signin")}</a>
        )}
      </div>
    </div>
  </nav>

  <!-- Hero -->
  <main class="flex-1">
    <section class="max-w-5xl mx-auto px-4 py-24 text-center">
      <h1 class="text-4xl md:text-5xl font-bold text-slate-900 mb-4">
        {t("hero.title")}
      </h1>
      <p class="text-lg text-slate-600 mb-8 max-w-2xl mx-auto">
        {t("hero.subtitle")}
      </p>
      <a href="#" class="btn-primary text-lg">
        {t("hero.cta")}
      </a>
    </section>
  </main>

  <!-- Footer -->
  <footer class="border-t border-slate-100 py-8">
    <div class="max-w-5xl mx-auto px-4 text-center text-sm text-slate-500">
      {t("footer.built_with")} <a href="https://astro.build" class="text-hasanat hover:underline">Astro</a>
      · {t("footer.hosted_on")} <a href="https://hasanat.dev" class="text-hasanat hover:underline">Hasanat.dev</a>
    </div>
  </footer>
</Layout>
